---
/*
 * Starlight's head (title, description, canonical, hreflang alternates, Open Graph and
 * Twitter basics, sitemap link), plus what the wiki adds:
 *   - the Commissioner faces preloaded, as on the main site, so text is set in its real face
 *     from the first paint (Cyrillic too on the Ukrainian pages);
 *   - theme-color for the browser chrome (ThemeProvider.astro keeps it in step);
 *   - an x-default alternate (the English page), og:locale in Open Graph's form with its
 *     alternates, the Open Graph image and Twitter tags;
 *   - a link back to the main site, and JSON-LD: the wiki as a WebSite published by the
 *     main site's Organization (the same @id its own JSON-LD declares), this page as a
 *     WebPage, and its BreadcrumbList, which follows the URL: wiki home > the folder's hub
 *     (/magic/, /uk/magic/) > page. Every crumb carries its URL, as Google requires.
 */
import Default from '@astrojs/starlight/components/Head.astro';
import latin from '../../styles/fonts/commissioner/commissioner-latin.woff2?url';
import latinExt from '../../styles/fonts/commissioner/commissioner-latin-ext.woff2?url';
import cyrillic from '../../styles/fonts/commissioner/commissioner-cyrillic.woff2?url';
import {MAIN_SITE, LOCALES, mainUrl, wikiPath} from '../../lib/site';
import {getEntry} from 'astro:content';
import {plainLabel} from '../../lib/sections';

const route = Astro.locals.starlightRoute;
const {entry, locale, lang, entryMeta, id} = route;
const site = Astro.site ?? new URL('https://wiki.mysterria.net');
const pageUrl = new URL(Astro.url.pathname, site).href;
const homeUrl = new URL(wikiPath(locale), site).href;
const isHome = id === '' || id === locale;
const isNotFound = id === '404' || id.endsWith('/404');

/* The home page is the site, not an article: og:type website (Starlight says article on every page). */
if (isHome) {
	for (const tag of route.head) {
		if (tag.tag === 'meta' && tag.attrs?.property === 'og:type') tag.attrs.content = 'website';
	}
}

/*
 * Open Graph wants language_TERRITORY (en_US, zh_TW), and Starlight writes the bare lang (en, zh-TW).
 * Each locale's usual territory, then the other seven as og:locale:alternate.
 */
const OG_LOCALES: Record<string, string> = {
	en: 'en_US', uk: 'uk_UA', ro: 'ro_RO', de: 'de_DE', es: 'es_ES', fr: 'fr_FR', 'zh-CN': 'zh_CN', 'zh-TW': 'zh_TW',
};
let ogLocale = OG_LOCALES[lang] ?? lang;
for (const tag of route.head) {
	if (tag.tag === 'meta' && tag.attrs?.property === 'og:locale') {
		ogLocale = OG_LOCALES[String(tag.attrs.content)] ?? String(tag.attrs.content);
		tag.attrs.content = ogLocale;
	}
}
const ogAlternates = Object.values(OG_LOCALES).filter(code => code !== ogLocale);

const pathWithoutLocale = locale ? Astro.url.pathname.replace(new RegExp(`^/${locale}(?=/)`), '') : Astro.url.pathname;
const xDefault = new URL(pathWithoutLocale, site).href;

const ogImage = new URL('/og-image.jpg', site).href;
const description = entry.data.description;

const WEBSITE_ID = `${site.origin}/#website`;
const ORG_ID = `${MAIN_SITE}/#organization`;

/*
 * wiki home > the folder's hub, named by its title in this language (or the English one it
 * falls back to) > this page. A hub itself is wiki home > hub.
 */
const crumbs: {name: string; item: string}[] = [{name: 'Mysterria Wiki', item: homeUrl}];
if (!isHome) {
	const [folder, ...rest] = pathWithoutLocale.split('/').filter(Boolean);
	if (folder && rest.length > 0) {
		const hub = (locale && (await getEntry('docs', `${locale}/${folder}`))) || (await getEntry('docs', folder));
		if (hub) crumbs.push({name: plainLabel(hub.data.title), item: new URL(wikiPath(locale, `/${folder}/`), site).href});
	}
	crumbs.push({name: plainLabel(entry.data.title), item: pageUrl});
}

const graph: Record<string, unknown>[] = [
	{
		'@type': 'WebSite',
		'@id': WEBSITE_ID,
		url: `${site.origin}/`,
		name: 'Mysterria Wiki',
		inLanguage: LOCALES.map(l => (l.key ? (l.key === 'zh-cn' ? 'zh-CN' : l.key === 'zh-tw' ? 'zh-TW' : l.key) : 'en')),
		publisher: {'@id': ORG_ID},
		isPartOf: {'@id': `${MAIN_SITE}/#website`},
	},
	{
		'@type': 'Organization',
		'@id': ORG_ID,
		name: 'Mysterria',
		url: `${MAIN_SITE}/`,
		logo: `${MAIN_SITE}/logo.webp`,
	},
];
if (!isNotFound) {
	graph.push({
		'@type': 'WebPage',
		'@id': `${pageUrl}#webpage`,
		url: pageUrl,
		name: entry.data.title,
		...(description ? {description} : {}),
		inLanguage: entryMeta.lang,
		isPartOf: {'@id': WEBSITE_ID},
		primaryImageOfPage: {'@type': 'ImageObject', url: ogImage},
		...(isHome ? {} : {breadcrumb: {'@id': `${pageUrl}#breadcrumb`}}),
	});
	if (!isHome) {
		graph.push({
			'@type': 'BreadcrumbList',
			'@id': `${pageUrl}#breadcrumb`,
			itemListElement: crumbs.map((crumb, i) => ({
				'@type': 'ListItem',
				position: i + 1,
				name: crumb.name,
				item: crumb.item,
			})),
		});
	}
}
const jsonLd = JSON.stringify({'@context': 'https://schema.org', '@graph': graph}).replace(/</g, '\\u003c');
---

<Default/>
<meta name="theme-color" content="#05070a"/>
{/*
  Pages open at once: the browser loads a wiki page in the background when a reader points at
  its link (prerender, so it is drawn too and the switch has no blank frame). The main site's
  pages are fetched the same way. Search JSON and Pagefind files are left alone.
*/}
<script is:inline type="speculationrules" set:html={JSON.stringify({
	prerender: [{where: {and: [{href_matches: '/*'}, {not: {href_matches: '/search/*'}}, {not: {href_matches: '/pagefind/*'}}]}, eagerness: 'moderate'}],
	prefetch: [{where: {href_matches: 'https://www.mysterria.net/*'}, eagerness: 'moderate'}],
})}/>
{/* let Google show a page's pictures large in results; the 404 page stays out of the index */}
<meta name="robots" content={isNotFound ? 'noindex, follow' : 'max-image-preview:large'}/>
<link rel="preload" href={latin} as="font" type="font/woff2" crossorigin/>
<link rel="preload" href={latinExt} as="font" type="font/woff2" crossorigin/>
{lang === 'uk' && <link rel="preload" href={cyrillic} as="font" type="font/woff2" crossorigin/>}
<link rel="alternate" hreflang="x-default" href={xDefault}/>
<link rel="home" href={mainUrl(locale, '')} title="Mysterria"/>
{ogAlternates.map(code => <meta property="og:locale:alternate" content={code}/>)}
<meta property="og:image" content={ogImage}/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
<meta property="og:image:alt" content="Mysterria, a Lord of the Mysteries Minecraft server"/>
<meta name="twitter:title" content={entry.data.title}/>
{description && <meta name="twitter:description" content={description}/>}
<meta name="twitter:image" content={ogImage}/>
<script type="application/ld+json" set:html={jsonLd}/>
