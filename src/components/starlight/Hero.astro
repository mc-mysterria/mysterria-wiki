---
/*
 * The landing page (any page with `hero` in its frontmatter: src/content/docs/index.md and
 * its translations), drawn the main site's way: a large flared title and a quiet lede over
 * the night art, then the two ways readers find things here.
 *
 * Most readers arrive looking for one page (Search Console: the landing page takes most of
 * the wiki's clicks). So the hero puts search first, a wide box that opens the same search as
 * the header, beside the Quick Start for new players. Under it are the most read pages, then
 * every page of the wiki grouped by section, in the sidebar's order and the reader's language.
 *
 * The copy comes from the page itself: the frontmatter's `title` and `hero` (tagline, and the
 * primary action). Section names and page titles are the sidebar's.
 */
import {Image} from 'astro:assets';
import StdButton from '../std/StdButton.vue';
import StdSectionHead from '../std/StdSectionHead.vue';
import StdTag from '../std/StdTag.vue';
import banner from '../../assets/brand/banner.webp';
import {flatLinks as flat, links, pageId, plainLabel, type SidebarGroup} from '../../lib/sections';
import {POPULAR} from '../../lib/popular.mjs';

const route = Astro.locals.starlightRoute;
const {data} = route.entry;
const {t} = Astro.locals;
const {title = data.title, tagline, actions = []} = data.hero || {};
const primary = actions.find(action => action.variant === 'primary') ?? actions[0];

const groups = route.sidebar.filter((entry): entry is SidebarGroup => entry.type === 'group');
const allLinks = groups.flatMap(group => links(group));
const popular = POPULAR.map(id => allLinks.find(link => pageId(link.href, route.locale) === id)).filter(link => link !== undefined);
const placeholder = t('wiki.search.placeholder');
---

<div class="landing not-content">
	<section class="landing-hero" aria-labelledby="_top">
		<div class="landing-hero__art" aria-hidden="true">
			<Image src={banner} alt="" widths={[640, 960, 1440]} sizes="(min-width: 800px) 60vw, 100vw" loading="eager" fetchpriority="high" decoding="async"/>
		</div>
		<div class="landing-hero__copy">
			<h1 id="_top" class="landing-hero__title" data-page-title set:html={title}/>
			{tagline && <p class="landing-hero__lede arc-lede" set:html={tagline}/>}
			<div class="landing-hero__actions">
				<button type="button" class="landing-search" onclick="window.dispatchEvent(new Event('wiki-search:open'))" aria-haspopup="dialog">
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13zM15.5 15.5L20 20"/></svg>
					<span>{placeholder}</span>
					<kbd aria-hidden="true">/</kbd>
				</button>
				{primary && <StdButton href={primary.link} variant="primary" size="lg" iconEnd="arrow-right" label={primary.text}/>}
			</div>
		</div>
	</section>

	<section class="landing-block" aria-labelledby="landing-popular" data-pagefind-ignore="all">
		<StdSectionHead title={t('landing.popular')} id="landing-popular"/>
		<ul class="landing-popular">
			{popular.map(page => <li><a href={page.href} class="landing-chip">{plainLabel(page.label)}</a></li>)}
		</ul>
	</section>

	<section class="landing-block" aria-labelledby="landing-all" data-pagefind-ignore="all">
		<StdSectionHead title={t('landing.allPages')} id="landing-all"/>
		<div class="landing-index">
			{
				groups.map((group, i) => (
					<section class="landing-group" aria-labelledby={`landing-group-${i}`}>
						<StdSectionHead title={group.label} count={flat(group).length} level={3} id={`landing-group-${i}`}/>
						<ul class="landing-links">
							{flat(group).map(page => (
								<li>
									<a href={page.href} class="landing-link">
										<span>{page.label}</span>
										{page.badge && <StdTag tone="acc" label={page.badge.text}/>}
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
	</section>
</div>
