---
/*
 * The landing page (any page with `hero` in its frontmatter: src/content/docs/index.md and
 * its translations), drawn the main site's way: its homepage hero (a large flared title,
 * a quiet lede, the bone primary and a tinted secondary over the night art), then the
 * wiki's sections as std cards, then every page of each section.
 *
 * The copy comes from the page itself. The hero is the frontmatter's `title` and `hero`
 * (tagline, actions), as Starlight reads it. The section cards are the sidebar's top-level
 * sections (their translated names), and the frontmatter's optional `landing.sections`
 * list can override a card by position. The page lists are the sidebar's.
 */
import {Image} from 'astro:assets';
import StdButton from '../std/StdButton.vue';
import StdCard from '../std/StdCard.vue';
import StdSectionHead from '../std/StdSectionHead.vue';
import StdTag from '../std/StdTag.vue';
import type {IconName} from '../std/icons';
import banner from '../../assets/brand/banner.webp';
import {links, plainLabel, type SidebarGroup} from '../../lib/sections';

const route = Astro.locals.starlightRoute;
const {data} = route.entry;
const {t} = Astro.locals;
const {locale} = route;
const {title = data.title, tagline, actions = []} = data.hero || {};

type Override = {title?: string; text?: string; icon?: IconName; link?: string};
const overrides: Override[] = (data as {landing?: {sections?: Override[]}}).landing?.sections ?? [];

/*
 * One card per top-level sidebar section, in sidebar order (astro.config.mjs). Sections are
 * not folders any more (Start here and High Sequences both hold magic/ pages), so they are
 * read from the sidebar itself. A card opens the section's first page and lists its first
 * pages as its text, in the reader's language.
 */
const ICONS: IconName[] = ['login', 'star', 'globe', 'flame', 'coin', 'shield', 'book'];
const groups = route.sidebar.filter((entry): entry is SidebarGroup => entry.type === 'group');

const cards = groups.map((group, index) => {
	const pages = links(group);
	const own = overrides[index];
	return {
		title: own?.title ?? plainLabel(group.label),
		text: own?.text ?? pages.slice(0, 3).map(page => plainLabel(page.label)).join(', '),
		icon: own?.icon ?? ICONS[index % ICONS.length],
		href: own?.link ?? pages[0]?.href ?? '/',
	};
});
---

<div class="landing not-content">
	<section class="landing-hero" aria-labelledby="_top">
		<div class="landing-hero__art" aria-hidden="true">
			<Image src={banner} alt="" widths={[640, 960, 1440]} sizes="(min-width: 800px) 60vw, 100vw" loading="eager" fetchpriority="high" decoding="async"/>
		</div>
		<div class="landing-hero__copy">
			<h1 id="_top" class="landing-hero__title" data-page-title set:html={title}/>
			{tagline && <p class="landing-hero__lede arc-lede" set:html={tagline}/>}
			{
				actions.length > 0 && (
					<div class="landing-hero__actions">
						{actions.map(action => (
							<StdButton
								href={action.link}
								variant={action.variant === 'primary' ? 'primary' : 'secondary'}
								size="lg"
								iconEnd={action.variant === 'primary' ? 'arrow-right' : undefined}
								label={action.text}
							/>
						))}
					</div>
				)
			}
		</div>
	</section>

	<section class="landing-block" aria-labelledby="landing-sections" data-pagefind-ignore="all">
		<StdSectionHead title={t('landing.sections')} id="landing-sections"/>
		<div class="card-grid landing-cards">
			{cards.map(card => <StdCard title={card.title} text={card.text} icon={card.icon} href={card.href} as="h3"/>)}
		</div>
	</section>

	<div class="landing-index" data-pagefind-ignore="all">
		{
			groups.map((group, i) => (
				<section class="landing-group" aria-labelledby={`landing-group-${i}`}>
					<StdSectionHead title={group.label} count={links(group).length} level={3} id={`landing-group-${i}`}/>
					<ul class="landing-links">
						{links(group).map(page => (
							<li>
								<a href={page.href} class="landing-link">
									<span>{plainLabel(page.label)}</span>
									{page.badge && <StdTag tone="acc" label={page.badge.text}/>}
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</div>
</div>
